    given-names: Leonardo Sarzedas do Carmo
    orcid: "https://orcid.org/0009-0001-0776-5159"
    affiliation: "Department of Mechanical Engineering, Federal University of Minas Gerais (UFMG)"
version: 1.0.0
license: MIT
repository-code: "https://github.com/EngSarzedas/Subjective-Ride-Comfort-ML"
keywords:
  - machine learning
  - ride comfort
  - vehicle dynamics
  - automotive suspensions
  - subjective evaluation
  - reproducible research
references:
